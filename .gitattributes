# Line endings: the scripts run under Linux, so every text file is stored
# and checked out with LF regardless of the platform the clone is made on.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.tsv text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.xlsx binary
*.pdf binary
*.png binary

# Language statistics. The results folder holds HRIBO's outputs (MultiQC
# and FastQC reports, interactive plots, tables, logs), not code written
# here, and the environment folder holds package lists. Both are marked as
# generated so that GitHub's language detection counts only the scripts.
results/** linguist-generated=true
environment/** linguist-generated=true
*.html linguist-detectable=false
